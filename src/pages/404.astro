---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Không tìm thấy trang">
    <div class="container section error-container">
        <div class="error-content">
            <h1 class="error-code">404</h1>
            <h2 class="error-title">
                Xin lỗi, trang quý khách tìm kiếm không tồn tại
            </h2>
            <p class="error-message">
                Trang web có thể đã được di chuyển hoặc xóa bỏ. Quý khách vui
                lòng quay lại cửa hàng để tiếp tục tham quan.
            </p>
            <a href="/" class="btn btn-primary">Quay lại trang chủ</a>
        </div>
    </div>
</Layout>

<style>
    .error-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
    }
    .error-content {
        max-width: 600px;
    }
    .error-code {
        font-size: 8rem;
        line-height: 1;
        color: var(--color-primary);
        opacity: 0.2;
        margin-bottom: -2rem;
        font-family: var(--font-serif);
    }
    .error-title {
        font-size: 2rem;
        margin-bottom: var(--spacing-md);
        color: var(--color-secondary);
    }
    .error-message {
        color: var(--color-text-muted);
        margin-bottom: var(--spacing-xl);
        font-size: 1.1rem;
    }
    .btn {
        display: inline-block;
        padding: var(--spacing-sm) var(--spacing-lg);
        background-color: var(--color-primary);
        color: white;
        border-radius: var(--radius-sm);
        font-weight: 700;
        text-transform: uppercase;
        transition: all var(--transition-normal);
    }
    .btn:hover {
        background-color: var(--color-primary-dark);
        transform: translateY(-2px);
    }
</style>
