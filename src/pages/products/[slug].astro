---
import Layout from "../../layouts/Layout.astro";
import ProductDetail from "../../components/ProductDetail";
import { getPublicProducts } from "../../lib/server/supabase";
import { toSlug } from "../../lib/utils";

const { slug } = Astro.params;
const { products } = await getPublicProducts(1, 1000); // Fetch all for lookup
const product = products.find((p) => toSlug(p.name) === slug);

if (!product) {
    return Astro.redirect("/404");
}
---

<Layout title={product.name} description={product.description}>
    <div class="container section page-navigation">
        <div class="breadcrumbs">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/#products">Products</a>
            <span>/</span>
            <span>{product.name}</span>
        </div>

        <ProductDetail product={product} client:load />
    </div>
</Layout>

<style>
    .page-navigation {
        padding: var(--spacing-xs);
    }
    .breadcrumbs {
        color: var(--color-text-muted);
        font-size: 0.875rem;
    }
    .breadcrumbs a:hover {
        color: var(--color-primary);
    }
    .breadcrumbs span {
        margin: 0 var(--spacing-xs);
    }
</style>
