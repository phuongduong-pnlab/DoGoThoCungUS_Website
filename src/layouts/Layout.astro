---
import "../styles/global.css";

import Navigation from "../components/Navigation.astro";

import SEO from "../components/SEO.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    mainClass?: string;
    type?: string;
}

const { title, description, image, mainClass = "", type } = Astro.props;
---

<!doctype html>
<html lang="vi">
    <head>
        <SEO
            title={title}
            description={description}
            image={image}
            type={type}
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Outfit:wght@300;400;500;700&family=Playfair+Display:wght@400;700&display=swap"
            rel="stylesheet"
        />

        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-FB281MQVYP"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", "G-FB281MQVYP");
        </script>
    </head>

    <body>
        <Navigation />
        <main class={mainClass}>
            <slot />
        </main>

        <script>
            // Protection: Disable right-click on all images
            document.addEventListener(
                "contextmenu",
                (e) => {
                    if ((e.target as HTMLElement).tagName === "IMG") {
                        e.preventDefault();
                    }
                },
                false,
            );
        </script>
    </body>
</html>

<style>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    main {
        flex: 1;
        width: 100%;
        margin-top: var(--header-height, 80px);
    }
</style>
